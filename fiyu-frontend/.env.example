# Fiyu frontend environment
#
# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored and must never be committed.

# Base URL of the Fiyu FastAPI backend.
# NOTE: NEXT_PUBLIC_ values are inlined into the browser bundle. This must be a
# public URL only -- never put a secret behind a NEXT_PUBLIC_ name.
NEXT_PUBLIC_FIYU_API_URL=http://127.0.0.1:8000

# Browser-restricted Google Maps JavaScript API key (used by the map only).
# In Google Cloud Console:
#   - Restrict by HTTP referrer (e.g. http://localhost:3000/*)
#   - Enable ONLY "Maps JavaScript API"
#   - Do NOT enable Places API on this key
# Leave blank to run without a map: the UI renders a documented placeholder
# instead of failing.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=

# Optional Map ID, for cloud-based map styling and Advanced Markers.
# Used in a later phase; safe to leave blank.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# ---------------------------------------------------------------------------
# NEVER add GOOGLE_PLACES_SERVER_KEY to this file or to any frontend env file.
# All Google Places Web Service calls are made server-side by the backend via
# GET /public/restaurants/{place_id}/live-details. The frontend must never call
# the Places Web Service directly.
# ---------------------------------------------------------------------------
