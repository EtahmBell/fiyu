# Fiyu frontend environment
#
# Copy this file to .env.local and adjust if needed.
# .env.local is git-ignored and must never be committed.

# Base URL of the Fiyu FastAPI backend.
# NOTE: NEXT_PUBLIC_ values are inlined into the browser bundle. This must be a
# public URL only -- never put a secret behind a NEXT_PUBLIC_ name.
NEXT_PUBLIC_FIYU_API_URL=http://127.0.0.1:8000

# Public Supabase project credentials used by the browser auth client.
# The anon key is intended for clients; never expose the service-role key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# There are deliberately no Google keys here.
#
# The discovery map is Fiyu's own SVG map, so no Maps JavaScript key is needed.
# Restaurant photos are proxied by the backend via
#   /public/restaurants/{place_id}/photo-preview
#   /public/restaurants/{place_id}/photos
# using GOOGLE_PLACES_SERVER_KEY, which is a backend-only secret. The browser
# never calls a Google API directly.
# ---------------------------------------------------------------------------
