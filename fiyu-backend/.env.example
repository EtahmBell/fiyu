FIYU_DB_PATH=data/fiyu.db
FIYU_CORS_ORIGINS=http://localhost:3000
FIYU_ENVIRONMENT=development
# Legacy anonymous/local owner headers are disabled automatically in production.
FIYU_ALLOW_LEGACY_CLIENT_ID=true

# Supabase Auth identity verification and account creation.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Backend only. Never expose this value through a NEXT_PUBLIC_* variable or a client bundle.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Required only for the legacy internal HTTP inspection endpoints.
# Use a long random server-side secret and send it as X-Fiyu-Admin-Key.
FIYU_ADMIN_API_KEY=
