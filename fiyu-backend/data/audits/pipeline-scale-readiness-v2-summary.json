    "picks_catalog": [
      "SEARCH public_restaurants USING INDEX idx_public_score (is_published=?)",
      "USE TEMP B-TREE FOR ORDER BY"
    ],
    "seed_unseeded": [
      "SEARCH r USING INDEX idx_restaurants_candidate (candidate_eligible=? AND internal_fiyu_score>?)",
      "CORRELATED SCALAR SUBQUERY 1",
      "SEARCH p USING COVERING INDEX sqlite_autoindex_public_restaurants_1 (place_id=?)",
      "USE TEMP B-TREE FOR ORDER BY"
    ],
    "research_queue": [
      "SCAN r",
      "BLOOM FILTER ON p (place_id=?)",
      "SEARCH p USING INDEX sqlite_autoindex_public_restaurants_1 (place_id=?)",
      "USE TEMP B-TREE FOR ORDER BY"
    ],
    "quality_v4_selector": [
      "MATERIALIZE latest",
      "CO-ROUTINE (subquery-3)",
      "SCAN q USING INDEX idx_quality_v4_runs_restaurant",
      "USE TEMP B-TREE FOR LAST TERM OF ORDER BY",
      "SCAN (subquery-3)",
      "SCAN p USING COVERING INDEX sqlite_autoindex_public_restaurants_1",
      "BLOOM FILTER ON latest (public_restaurant_id=? AND row_number=?)",
      "SEARCH latest USING AUTOMATIC PARTIAL COVERING INDEX (public_restaurant_id=? AND row_number=?) LEFT-JOIN"
